# Copy to .env and fill in. `./setup.sh` writes this file for you.

# --- Required ---------------------------------------------------------------

# API key from resend.com (Sending + Receiving access)
RESEND_API_KEY=re_xxxxxxxx

# Your Kindle's Send-to-Kindle address
# (amazon.com/mycd -> Preferences -> Personal Document Settings)
KINDLE_EMAIL=you_xxxx@kindle.com

# Sender address on your Resend-verified domain. This exact address must be
# added to Amazon's "Approved Personal Document E-mail List".
FROM_EMAIL=claude@scribe.example.com

# Shared secret for the REST endpoints. Generate: openssl rand -hex 32
BRIDGE_TOKEN=change-me

# The address you share annotated documents to from the Scribe. REQUIRED:
# Resend inbound is catch-all, so without this any stranger who knows your
# domain could feed documents into your inbox.
RETURN_EMAIL=inbox@scribe.example.com

# --- MCP (Claude connector) -------------------------------------------------

# Secret path segment for the MCP endpoint: https://<host>/<MCP_TOKEN>/mcp
# The URL is the credential — treat it like a password. Empty disables MCP.
# Generate: openssl rand -hex 24
MCP_TOKEN=

# Public hostnames the MCP transport accepts (comma-separated). The MCP SDK
# rejects any Host header not listed. "*" disables the check, which is fine
# when the secret path is the only way in.
MCP_ALLOWED_HOSTS=*

# --- Optional ---------------------------------------------------------------

# Signing secret from Resend -> Webhooks. Strongly recommended: without it the
# webhook accepts unsigned requests.
RESEND_WEBHOOK_SECRET=

# ntfy.sh topic for a phone push when an annotated document arrives.
# Use a long random name — anyone who knows it can subscribe. Empty = off.
NTFY_TOPIC=

# Delete stored documents after N days (0 = keep forever).
INBOX_RETENTION_DAYS=0

# Where returned documents are stored (inside the container by default).
INBOX_DIR=/data/inbox

# Where the markdown of sent documents is kept, so a returning document can be
# paired with the text it was made from. Defaults next to INBOX_DIR.
OUTBOX_DIR=/data/outbox
