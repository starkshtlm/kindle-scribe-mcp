# Copy to .env and fill in. `./setup.sh` writes this file for you.

# How mail moves, set per direction because the two cost different things.
#
#   MAIL_OUT=smtp     send from a mailbox you already have (app password)
#   MAIL_OUT=resend   send from your own Resend-verified domain
#   MAIL_IN=imap      poll that mailbox — no domain, no webhook, and the
#                     bridge never has to be reachable from the internet
#   MAIL_IN=resend    Resend's webhook. Works on a free <id>.resend.app
#                     receiving address, so this needs no domain either, but
#                     the bridge must answer on public HTTPS
#
# The three combinations people actually use:
#   smtp + imap     fastest to set up, documents return within a minute
#   smtp + resend   no domain, but push instead of polling
#   resend + resend your own sending domain, push both ways
#
# The older single switch still works: MAIL_TRANSPORT=mailbox means smtp+imap,
# MAIL_TRANSPORT=resend means resend+resend.
MAIL_OUT=smtp
MAIL_IN=imap

# --- Always required --------------------------------------------------------

# Your Kindle's Send-to-Kindle address
# (amazon.com/mycd -> Preferences -> Personal Document Settings)
KINDLE_EMAIL=you_xxxx@kindle.com

# The address you share annotated documents to from the Scribe. Only mail sent
# here is processed. With MAIL_IN=imap this is your own address; with
# MAIL_IN=resend it is the receiving address Resend gave you.
RETURN_EMAIL=you@example.com

# Shared secret for the REST endpoints. Generate: openssl rand -hex 32
BRIDGE_TOKEN=change-me

# Secret path segment for the MCP endpoint: https://<host>/<MCP_TOKEN>/mcp
# The URL is the credential — treat it like a password. Empty disables MCP.
# Generate: openssl rand -hex 24
MCP_TOKEN=

# --- MAIL_OUT=smtp / MAIL_IN=imap -------------------------------------------
# Use an app password, never your account password. Gmail, iCloud, Fastmail and
# most own-domain hosts issue them. Outlook.com and Google Workspace cannot —
# both are OAuth-only now, so use the Resend path there.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# --- MAIL_OUT=resend / MAIL_IN=resend ---------------------------------------

# API key from resend.com. Needed by either direction: sending uses it, and
# receiving fetches the mail body with it after the webhook fires. Full access
# is required if you want ./scribe-finish to create the webhook for you.
RESEND_API_KEY=

# Sender address. With MAIL_OUT=resend it must be on your verified domain;
# with MAIL_OUT=smtp it defaults to SMTP_USER. Either way this exact address
# must be added to Amazon's "Approved Personal Document E-mail List".
FROM_EMAIL=claude@scribe.example.com

# Written by ./scribe-finish. Without it the webhook answers 503 and nothing
# can arrive.
RESEND_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------

# ntfy.sh topic for a phone push when a document arrives or is rejected.
# Use a long random name — anyone who knows it can subscribe. Empty = off.
NTFY_TOPIC=

# Delete stored documents after N days (0 = keep forever).
INBOX_RETENTION_DAYS=30

INBOX_DIR=/data/inbox
OUTBOX_DIR=/data/outbox

# Public hostnames the MCP transport accepts (comma-separated). "*" disables
# the DNS-rebinding check, which is fine when the secret path is the only way in.
MCP_ALLOWED_HOSTS=*
