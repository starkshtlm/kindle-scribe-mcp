#!/usr/bin/env python3
"""Finish the domain (Resend) setup once the bridge is publicly reachable.

Creates the inbound webhook through Resend's API, stores the signing secret it
returns, and checks the two domain capabilities people most often get wrong.
The webhook cannot be created earlier than this: it needs a public URL, which
does not exist until the bridge is deployed.

    ./scribe-finish https://bridge.example.com
"""

import json
import pathlib
import re
import sys
import urllib.error
import urllib.request

API = "https://api.resend.com"
ENV = pathlib.Path(__file__).with_name(".env")


def die(message: str) -> None:
    print(f"\n✗ {message}")
    sys.exit(1)


def read_env() -> dict:
    if not ENV.exists():
        die(".env not found — run ./setup.sh first.")
    values = {}
    for line in ENV.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    return values


def api(key: str, method: str, path: str, payload: dict | None = None):
    request = urllib.request.Request(
        f"{API}{path}",
        method=method,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "User-Agent": "kindle-scribe-mcp/setup",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode()[:200]
        if exc.code in (401, 403):
            die(
                "Resend rejected the API key for this call. Webhook management "
                "needs a Full access key — a sending-only key cannot create "
                "webhooks. Create one at resend.com/api-keys and update "
                f"RESEND_API_KEY in .env.\n  ({exc.code}: {body})"
            )
        die(f"Resend API error {exc.code}: {body}")
    except urllib.error.URLError as exc:
        die(f"Could not reach the Resend API: {exc.reason}")


def main() -> None:
    if len(sys.argv) != 2:
        die("Usage: ./scribe-finish https://your-public-host")
    base = sys.argv[1].rstrip("/")
    if not base.startswith("https://"):
        die("The public URL must be https:// — Claude and Resend both require TLS.")

    env = read_env()
    key = env.get("RESEND_API_KEY", "")
    if not key:
        die("RESEND_API_KEY is empty in .env. This script sets up the webhook, "
            "so it is only for MAIL_IN=resend; polling over IMAP needs none.")

    return_domain = env.get("RETURN_EMAIL", "").partition("@")[2].lower()

    # Resend hands every account a managed receiving domain. It has no DNS to
    # get wrong and never appears under /domains, so the capability check below
    # would only produce a confusing warning about a domain you do not own.
    if return_domain.endswith(".resend.app"):
        print(f"Receiving on Resend's managed domain {return_domain} — "
              "nothing to verify.")
    else:
        check_domain(key, return_domain)

    register_webhook(key, base, env)


def check_domain(key: str, return_domain: str) -> None:
    print("Checking your Resend domain…")
    domains = api(key, "GET", "/domains").get("data", [])
    match = next(
        (d for d in domains
         if return_domain and return_domain.endswith(d.get("name", "\0").lower())),
        None,
    )
    if match is None:
        print(f"  ! No Resend domain matches {return_domain or '(unset)'} — "
              "check RETURN_EMAIL in .env.")
    else:
        caps = match.get("capabilities") or {}
        status = match.get("status")
        print(f"  domain {match.get('name')}: status={status} "
              f"sending={caps.get('sending')} receiving={caps.get('receiving')}")
        if status != "verified":
            print("  ! Not verified yet — DNS records may still be propagating.")
        if caps.get("receiving") != "enabled":
            die(
                "Receiving is not enabled for this domain, so no document can "
                "ever arrive. Open the domain in the Resend dashboard and switch "
                "'Enable Receiving' on (the toggle in the add-domain form does "
                "not always stick), then run this again."
            )


def register_webhook(key: str, base: str, env: dict) -> None:
    endpoint = f"{base}/webhook/inbound"
    print(f"Registering webhook for {endpoint} …")

    existing = api(key, "GET", "/webhooks").get("data", [])
    already = next((w for w in existing if w.get("endpoint") == endpoint), None)
    if already:
        print(f"  webhook already exists ({already.get('id')}) — reusing it.")
        if not env.get("RESEND_WEBHOOK_SECRET"):
            die(
                "The webhook exists but .env has no signing secret, and Resend "
                "only reveals it at creation time. Delete the webhook in the "
                "dashboard and run this again to get a fresh secret."
            )
        secret = env["RESEND_WEBHOOK_SECRET"]
    else:
        created = api(key, "POST", "/webhooks",
                      {"endpoint": endpoint, "events": ["email.received"]})
        secret = created.get("signing_secret", "")
        if not secret:
            die(f"Resend did not return a signing secret: {created}")
        print(f"  created webhook {created.get('id')}")

    text = ENV.read_text()
    if re.search(r"^RESEND_WEBHOOK_SECRET=.*$", text, re.M):
        text = re.sub(r"^RESEND_WEBHOOK_SECRET=.*$",
                      f"RESEND_WEBHOOK_SECRET={secret}", text, flags=re.M)
    else:
        text += f"\nRESEND_WEBHOOK_SECRET={secret}\n"
    ENV.write_text(text)
    print("  signing secret written to .env")

    print("\n✓ Done. Restart the bridge so it picks up the secret:")
    print("    docker compose up -d")
    print(f"\n  Connector URL:  {base}/{env.get('MCP_TOKEN', '<MCP_TOKEN>')}/mcp")
    print(f"  Share to:       {env.get('RETURN_EMAIL', '')}")


if __name__ == "__main__":
    main()
